{
  "name": "seatsense",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm run dev --prefix client\"",
    "dev:api": "node --watch src/index.js",
    "db:local": "node scripts/local-db.js",
    "db:setup": "node scripts/setup-db.js",
    "build": "npm run build --prefix client",
    "vercel-build": "npm ci --prefix client && npm run build --prefix client",
    "lint": "npm run lint --prefix client",
    "start": "node src/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "concurrently": "^9.2.5"
  }
}
